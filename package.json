{
  "name": "spenddesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --import ./scripts/load-env.mjs --import tsx scripts/migrate.ts",
    "sync": "node --import ./scripts/load-env.mjs --import tsx scripts/sync.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test:browser": "playwright test",
    "test:integration": "node --env-file=.env.local --import tsx --test tests/integration/*.test.ts",
    "local": "tsx scripts/local-db.ts --app",
    "local:setup": "tsx scripts/open-local-setup.ts",
    "format": "prettier --write app lib scripts tests components/dashboard.tsx components/sign-in.tsx next.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "^16.2.0",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
