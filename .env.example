# Both Railway application services use the same database and encryption key.
DATABASE_URL=postgresql://user:password@host:5432/storedesk
APP_URL=https://your-dashboard.up.railway.app
SESSION_SECRET=
ENCRYPTION_KEY=
# One-time first-owner enrollment; generate with openssl rand -hex 32.
SETUP_TOKEN=
GOOGLE_ADS_API_VERSION=v25
SHOPIFY_API_VERSION=2026-07
# Only used by the local development server. Never bypasses production auth.
LOCAL_DEV_AUTH=false
# Set true on report-sync; keep false on the web service.
SYNC_SCHEDULED=false
